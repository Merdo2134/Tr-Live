PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://trlive:CHANGE_ME@127.0.0.1:5432/trlive
# Yerel/Docker veritabanı için false; yönetilen (bulut) veritabanı için no-verify veya true
DATABASE_SSL=false
# Üretimde en az 32 karakter rastgele değer ZORUNLUDUR (örn: openssl rand -hex 48)
JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://livekit.example.com
# Virgülle ayrılmış liste; mobil uygulama için * bırakılabilir
CORS_ORIGIN=*
# Ters vekil (nginx, Cloudflare vb.) arkasındaysanız 1 yapın; doğrudan yayındaysa boş bırakın
TRUST_PROXY=
# Profil görsellerinin saklanacağı dizin
UPLOAD_DIR=./uploads
# Bu Coin değerinin üstündeki hediyeler tüm kullanıcılara global şerit olarak gider
GLOBAL_GIFT_MIN_COINS=1000
# --- Güvenlik duvarı ---
FIREWALL_ENABLED=true
# Asla otomatik yasaklanmayacak IP'ler (virgülle). Kendi yönetim IP'nizi ekleyin.
FIREWALL_ALLOW_IPS=
# IP başına dakikadaki en fazla istek / otomatik yasak için ihlal puanı eşiği (10 dk içinde)
FIREWALL_IP_PER_MINUTE=300
FIREWALL_BAN_THRESHOLD=30
# --- Sohbet/mesaj filtresi: yasaklı kelimeler (virgülle, kendi politikanıza göre) ---
BANNED_WORDS=
