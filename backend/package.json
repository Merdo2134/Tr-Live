{
  "name": "tr-live-backend",
  "version": "2.2.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/migration_runner.js",
    "test": "node --test",
    "check": "node --check src/server.js && node --check src/migration_runner.js",
